# Hub shared secrets (paste your keys here)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Per-tool OpenAI keys (optional — each tool falls back to OPENAI_API_KEY above)
# Use separate keys when projects have different model access (e.g. Audio API for video)
# Video Scraper — transcription + summarization
# gpt-5-mini cannot transcribe audio; transcription runs locally by default.
TRANSCRIPTION_PROVIDER=local
LOCAL_WHISPER_MODEL=small
# TRANSCRIPTION_PROVIDER=openai
# TRANSCRIPTION_MODEL=whisper-1
MARKET_DEPTH_OPENAI_API_KEY=
MARKET_DEPTH_OPENAI_MODEL=
BUILD_READINESS_OPENAI_API_KEY=
BUILD_READINESS_OPENAI_MODEL=
LEAD_INTELLIGENCE_OPENAI_API_KEY=
LEAD_INTELLIGENCE_OPENAI_MODEL=

GITHUB_TOKEN=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Database & cache
POSTGRES_USER=toolhub
POSTGRES_PASSWORD=toolhub
POSTGRES_DB=toolhub
DATABASE_URL=postgresql://toolhub:toolhub@postgres:5432/toolhub
REDIS_URL=redis://redis:6379/0

# Host ports (default avoids CRM stack on 3000/5432/6379)
WEB_HOST_PORT=3200
VIDEO_SCRAPER_HOST_PORT=8101
MARKET_DEPTH_HOST_PORT=8102
LEAD_INTELLIGENCE_HOST_PORT=8103
BUILD_READINESS_HOST_PORT=8104

# Browser-facing API URLs
VIDEO_SCRAPER_PUBLIC_URL=http://localhost:8101
MARKET_DEPTH_PUBLIC_URL=http://localhost:8102
LEAD_INTELLIGENCE_PUBLIC_URL=http://localhost:8103
BUILD_READINESS_PUBLIC_URL=http://localhost:8104

# Internal Docker service URLs
VIDEO_SCRAPER_API_URL=http://video-scraper-api:8001
MARKET_DEPTH_API_URL=http://market-depth-api:8002
LEAD_INTELLIGENCE_API_URL=http://lead-intelligence-api:8003
BUILD_READINESS_API_URL=http://build-readiness-api:8004

# Build Readiness Engine
DEFAULT_COMPANY_URL=https://www.antier.com/
DEFAULT_COMPANY_NAME=Antier
MAX_CRAWL_PAGES=120
EMBEDDING_MODEL=text-embedding-3-small

# Video Scraper (see TRANSCRIPTION_PROVIDER at top — local = no whisper API)
VIDEO_SCRAPER_OPENAI_API_KEY=
VIDEO_SCRAPER_OPENAI_MODEL=
# Max videos scraped per page URL (batch mode)
MAX_VIDEOS_PER_PAGE=25
MAX_VIDEO_DURATION_SECONDS=7200
RATE_LIMIT_PER_DOMAIN_SECONDS=1
IGNORE_ROBOTS_TXT=false
VIDEO_DISCOVERY_IGNORE_ROBOTS=true

# MinIO temp staging for video scraper
MINIO_ENABLED=true
MINIO_HOST_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=toolhub
MINIO_ROOT_PASSWORD=toolhubsecret
MINIO_BUCKET=video-scraper-temp
MINIO_SECURE=false

# Lead Intelligence
APOLLO_API_KEY=
HUNTER_API_KEY=
CLEARBIT_API_KEY=
SAM_GOV_API_KEY=
CRUNCHBASE_API_KEY=

# Hub platform auth
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3200
HUB_ADMIN_PASSWORD=admin123
HUB_SERVICE_KEY=
