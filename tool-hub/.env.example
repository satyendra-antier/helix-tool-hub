# Hub shared secrets (paste your keys here)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GITHUB_TOKEN=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Database & cache
POSTGRES_USER=toolhub
POSTGRES_PASSWORD=toolhub
POSTGRES_DB=toolhub
DATABASE_URL=postgresql://toolhub:toolhub@postgres:5432/toolhub
REDIS_URL=redis://redis:6379/0

# Host ports (default avoids CRM stack on 3000/5432/6379)
WEB_HOST_PORT=3200
VIDEO_SCRAPER_HOST_PORT=8101
MARKET_DEPTH_HOST_PORT=8102
LEAD_INTELLIGENCE_HOST_PORT=8103
BUILD_READINESS_HOST_PORT=8104

# Browser-facing API URLs
VIDEO_SCRAPER_PUBLIC_URL=http://localhost:8101
MARKET_DEPTH_PUBLIC_URL=http://localhost:8102
LEAD_INTELLIGENCE_PUBLIC_URL=http://localhost:8103
BUILD_READINESS_PUBLIC_URL=http://localhost:8104

# Internal Docker service URLs
VIDEO_SCRAPER_API_URL=http://video-scraper-api:8001
MARKET_DEPTH_API_URL=http://market-depth-api:8002
LEAD_INTELLIGENCE_API_URL=http://lead-intelligence-api:8003
BUILD_READINESS_API_URL=http://build-readiness-api:8004

# Build Readiness Engine
DEFAULT_COMPANY_URL=https://www.antier.com/
DEFAULT_COMPANY_NAME=Antier
MAX_CRAWL_PAGES=120
EMBEDDING_MODEL=text-embedding-3-small

# Video Scraper
TRANSCRIPTION_PROVIDER=openai
MAX_VIDEO_DURATION_SECONDS=7200
RATE_LIMIT_PER_DOMAIN_SECONDS=1
IGNORE_ROBOTS_TXT=false

# Lead Intelligence
APOLLO_API_KEY=
HUNTER_API_KEY=
CLEARBIT_API_KEY=
SAM_GOV_API_KEY=
CRUNCHBASE_API_KEY=
